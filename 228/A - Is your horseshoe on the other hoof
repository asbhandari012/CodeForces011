import java.util.*;
 
public class Main {
 
    public static void main(String args[]){
 
        Scanner ui = new Scanner(System.in);
 
        HashSet<Integer> set = new HashSet<>();
 
        for(int i = 0; i < 4; i++){
            int n = ui.nextInt();
 
            set.add(n);
        }
 
        System.out.println(4 - set.size());
    }
}